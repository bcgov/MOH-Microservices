{
  "name": "msp-service",
  "version": "3.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node $NODE_DEBUG_OPTION src/index.js server",
    "start-local-service": "bin/start-local-msp-service.sh",
    "start-mock-logger": "nodemon bin/mock-logger.js",
    "start-mock-api": "nodemon bin/mock-api.js",
    "send-test-api-call": "node bin/send-test-api-call.js",
    "dev": "nodemon --watch src --exec node ./src/index.js server",
    "lint": "eslint .",
    "format": "prettier . --write",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:lint": "eslint .",
    "test:schema": "echo \"WARNING: No schema specified\" && exit 0",
    "prepare": "node bin/check-husky.mjs",
    "pre-commit": "lint-staged",
    "pre-commit:lint": "eslint",
    "pre-commit:prettier": "prettier --check --ignore-unknown"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bcgov/MOH-Microservices"
  },
  "author": "",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/bcgov/MOH-Microservices/issues"
  },
  "homepage": "https://github.com/bcgov/MOH-Microservices/blob/main/README.md",
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "http-proxy-middleware": "^3.0.5",
    "json-stringify-safe": "^5.0.1",
    "jsonwebtoken": "^9.0.3",
    "moment": "^2.29.4",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.3.16",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-compat": "^6.0.2",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "browserslist": [
    "node 18",
    "node 20",
    "node 22",
    "not op_mini all"
  ]
}
