{
  "name": "spa-env-server",
  "version": "0.9.0",
  "description": "Serve environment variables of server to remote SPAs (no secrets! only public info)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bcgov/MOH-Microservices.git"
  },
  "homepage": "",
  "main": "index.js",
  "scripts": {
    "build": "NODE_ENV=production gulp",
    "start": "node $NODE_DEBUG_OPTION build/index.js server",
    "start-local-service": "bin/start-local-service.sh",
    "send-test-request": "bin/send-test-request.sh",
    "dev": "nodemon --watch src --inspect=0.0.0.0:9229 --exec node ./src/index.js server",
    "test": "vitest run -- --no-threads",
    "test:coverage": "vitest run --coverage",
    "test:lint": "echo \"WARNING: No LINTer specified\" && exit 0",
    "test:schema": "echo \"WARNING: No schema specified\" && exit 0"
  },
  "dependencies": {
    "body-parser": "^1.20.2",
    "express": "^5.2.1",
    "express-basic-auth": "^1.2.0",
    "ini": "^2.0.0",
    "json-stringify-safe": "^5.0.1",
    "moment-timezone": "^0.5.43",
    "serve-index": "^1.9.1",
    "winston": "^3.1.0",
    "winston-daily-rotate-file": "^3.3.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.8",
    "gulp": "^4.0.2",
    "gulp-clean": "^0.4.0",
    "gulp-sourcemaps": "^2.6.5",
    "gulp-typescript": "^6.0.0-alpha.1",
    "nodemon": "^2.0.22",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
